# Copy to .env.local for local work. With none of these set the app runs on the in-memory mock,
# which is what the Lovable preview and the demo use: never set them in Lovable.

# Default data source for every repository: mock (default) | http (the real API).
VITE_API_MODE=mock

# Base URL of the real API, including /api/v1. Default: http://localhost:3100/api/v1
# The API must list this front's origin in FRONT_ORIGINS (CORS with credentials, CSRF by Origin).
VITE_API_URL=http://localhost:3100/api/v1

# Per-repository override (mock | http); wins over VITE_API_MODE. Every repository has an HTTP adapter.
# Note: repositories left on the mock keep the mock's own demo user, independent of the real session.
# VITE_API_MODE_SESSION=http
# VITE_API_MODE_USERS=http
# VITE_API_MODE_CALENDAR=http
# VITE_API_MODE_ORGANIZATIONS=http
# VITE_API_MODE_BUSINESSES=http
# VITE_API_MODE_BUSINESS_PROFILE=http
# VITE_API_MODE_ROUTING=http
# VITE_API_MODE_LEADS=http
# VITE_API_MODE_DOCUMENTS=http
# VITE_API_MODE_NOTIFICATIONS=http
# VITE_API_MODE_BUSINESS_FILE=http
# VITE_API_MODE_BISHOP=http
# VITE_API_MODE_FUNDS=http
# VITE_API_MODE_DISTRIBUTION=http
# VITE_API_MODE_RULES=http
# VITE_API_MODE_CATALOG=http
# VITE_API_MODE_TASKS=http
# VITE_API_MODE_BRAND=http
# VITE_API_MODE_NETWORK=http
# VITE_API_MODE_FRANCHISES=http
# VITE_API_MODE_MANUAL=http
# VITE_API_MODE_FINANCIALS=http
# VITE_API_MODE_FRANCHISEE=http
# On leads, the demo-only "Simular entrada" (simulateAssessment, simulateBooking) and the deprecated
# startProgram answer not_implemented: keep LEADS on the mock to demo them.
# On users, "Simular aceptación" (demo only) resends the invitation instead; connecting Google Calendar sends the
# person to Google's consent screen and back to /perfil?calendar=connected|denied|error.
# On funds and distribution, receipts must be real files: the simulated { file_name, size_kb } of the
# demo picker is refused with invalid_file.
# On tasks and brand, deliverables, answers, evidence, logos and manuals must be real files too (invalid_file
# otherwise). A brand logo or manual left unchanged is resent by its stored file id, without uploading again.
# On documents, contracts are signed in DocuSeal's embedded form when the API runs SIGNING_DRIVER=docuseal.
# On calendar (v2: availability and portal meetings in Google), connecting goes through Google's consent screen like
# USERS; set both together so Mi perfil and the scheduling dialog read the same connection.
